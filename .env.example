# Application
APP_NAME="FastAPI AWS Backend"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX="/api/v1"

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastapi_app
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# AWS RDS
RDS_INSTANCE_IDENTIFIER=
RDS_ENDPOINT=
RDS_PORT=5432
RDS_DB_NAME=
RDS_USERNAME=
RDS_PASSWORD=
RDS_POOL_SIZE=10
RDS_MAX_OVERFLOW=20
RDS_POOL_TIMEOUT=30
RDS_POOL_RECYCLE=1800
RDS_POOL_PRE_PING=true

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=http://localhost:4566
AWS_SESSION_TOKEN=

# LocalStack
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_DOCKER_NAME=localstack-main
LOCALSTACK_VOLUME_DIR=./volume

# S3
S3_BUCKET=fastapi-uploads
S3_PRESIGNED_URL_EXPIRY=3600
S3_MAX_FILE_SIZE=10485760

# DynamoDB
DYNAMODB_TABLE=fastapi-items
DYNAMODB_ENDPOINT_URL=http://localhost:4566

# SQS
SQS_QUEUE_URL=http://localhost:4566/000000000000/fastapi-queue
SQS_VISIBILITY_TIMEOUT=300
SQS_MAX_RECEIVE_COUNT=3

# SNS
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:fastapi-notifications

# Secrets Manager
SECRETS_MANAGER_SECRET=fastapi/secrets

# Lambda
LAMBDA_FUNCTION_NAME=

# CloudWatch
CLOUDWATCH_LOG_GROUP=/aws/fastapi/app
CLOUDWATCH_LOG_STREAM=application

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# SigNoz / OpenTelemetry
SIGNOZ_ENABLED=true
SIGNOZ_OTLP_ENDPOINT=http://localhost:4318
SIGNOZ_SERVICE_NAME=fastapi-aws-backend
SIGNOZ_SERVICE_VERSION=1.0.0
SIGNOZ_DEPLOYMENT_ENVIRONMENT=development
SIGNOZ_TRACING_SAMPLE_RATE=1.0
SIGNOZ_UI_URL=http://localhost:3301

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0