# Production Environment Variables
# Copy to .env.production and fill in values

# Application
APP_NAME="FastAPI AWS Backend"
APP_VERSION="1.0.0"
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX="/api/v1"

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Security - GENERATE NEW SECRET KEY FOR PRODUCTION!
# openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=12

# Database - Use managed PostgreSQL (RDS, Cloud SQL, etc.)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30

# Redis - Use managed Redis (ElastiCache, Memorystore, etc.)
REDIS_URL=redis://:password@host:6379/0
REDIS_MAX_CONNECTIONS=100
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 - Create bucket beforehand
S3_BUCKET=myapp-uploads-prod
S3_PRESIGNED_URL_EXPIRY=3600
S3_MAX_FILE_SIZE=52428800

# DynamoDB - Create table beforehand
DYNAMODB_TABLE=myapp-items-prod

# SQS - Create queue beforehand
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/myapp-queue

# SNS - Create topic beforehand
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:myapp-notifications

# Secrets Manager - Create secret beforehand
SECRETS_MANAGER_SECRET=myapp/secrets/prod

# Lambda - Optional
LAMBDA_FUNCTION_NAME=

# CloudWatch
CLOUDWATCH_LOG_GROUP=/aws/ecs/myapp-prod
CLOUDWATCH_LOG_STREAM=backend

# CORS - Set to your frontend domain(s)
CORS_ORIGINS=["https://myapp.com", "https://admin.myapp.com"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# Rate Limiting
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@myapp.com

# Celery
CELERY_BROKER_URL=redis://:password@host:6379/0
CELERY_RESULT_BACKEND=redis://:password@host:6379/0

# Docker
DOCKER_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
VERSION=latest